# ── Server ───────────────────────────────────────────────
PORT=3001
# Set NODE_ENV to production on your host
# NODE_ENV=production
# Postgres connection string. Local Docker example (see README); use your hosted
# database URL (e.g. Neon) in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/auction_arena
# Long random string that signs login tokens. Generate one with: openssl rand -hex 48
JWT_SECRET=

# ── Google sign-in (optional) ────────────────────────────
# Google Cloud Console → Google Auth Platform → Clients → Web application
# Authorized JavaScript origins: http://localhost:5173 and your production URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
