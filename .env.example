# ── Server ───────────────────────────────────────────────
PORT=3001
# Set NODE_ENV to production on your host
# NODE_ENV=production
# Postgres connection string. Local Docker example (see README); use your hosted
# database URL (e.g. Neon) in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/auction_arena
# Long random string that signs login tokens. Generate one with: openssl rand -hex 48
JWT_SECRET=

# ── Google sign-in (optional) ────────────────────────────
# Google Cloud Console → Google Auth Platform → Clients → Web application
# Authorized JavaScript origins: http://localhost:5173 and your production URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GIFs in chat (optional) ──────────────────────────────
# Free key from developers.giphy.com. Without it the chat has no GIF button.
VITE_GIPHY_API_KEY=

# Shown on the privacy page for questions and deletion requests (optional)
VITE_CONTACT_EMAIL=

# ── AI power rankings (optional) ─────────────────────────
# console.groq.com → API Keys (AI rankings on the auction results page)
GROQ_API_KEY=
# Optional: a Groq model with structured outputs (default: openai/gpt-oss-120b)
GROQ_MODEL=

# ── Fantasy admin (optional) ─────────────────────────────
# The Google account allowed on /admin/fantasy (it must sign in with Google)
ADMIN_EMAIL=

# ── Fantasy points (optional) ────────────────────────────
# cricapi.com → API key, used by `npm run fantasy:update` / `fantasy:backfill`
CRICKET_API_KEY=
