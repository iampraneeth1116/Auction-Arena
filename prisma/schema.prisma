// Generates TypeScript into server/generated (gitignored). Node 24 runs it directly
// through its built-in type stripping. Run `npm run db:generate` after editing this file.
generator client {
  provider               = "prisma-client"
  output                 = "../server/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

// The connection URL is set in prisma.config.js
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  isGuest      Boolean  @default(false)
  isBot        Boolean  @default(false) // one per franchise, id "bot_<TEAM>"; can never sign in
  createdAt    DateTime @default(now())

  refreshTokens RefreshToken[]
  memberships   RoomMember[]
  fantasySquads FantasySquad[]
}

// Opaque refresh tokens, stored only as SHA-256 hashes. Rotated on every use.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Money columns are whole lakhs (1 Cr = 100 L) so bid increments never drift.
model Room {
  id            String   @id
  hostId        String
  status        String   @default("waiting") // waiting | active | completed
  auctionType   String
  squadLimit    Int
  overseasLimit Int
  budget        Int
  bidTimer      Int      @default(10)
  playerOrder   Int[]
  currentIndex  Int      @default(0)
  liveState     Json?
  bannedUserIds String[] @default([])
  quickPool     Boolean  @default(false) // pool sized to the game: franchises × squad limit + 10
  rotateUnsold  Boolean  @default(true) // unsold players come back in further rounds
  round         Int      @default(1)
  roundStart    Int      @default(0) // index in playerOrder where the current round began
  createdAt     DateTime @default(now())

  members      RoomMember[]
  purchases    Purchase[]
  messages      Message[]
  fantasySquads FantasySquad[]
  powerRanking  PowerRanking?
}

// AI squad ratings for a completed auction, generated once and reused
model PowerRanking {
  roomId      String   @id
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  model       String
  rankings    Json
  generatedAt DateTime @default(now())
}

model RoomMember {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  teamId          String?
  budgetRemaining Int
  isBot           Boolean  @default(false)
  joinedAt        DateTime @default(now())

  purchases Purchase[]

  @@unique([roomId, userId])
  @@unique([roomId, teamId])
  @@index([userId])
}

model Purchase {
  id        String     @id @default(cuid())
  roomId    String
  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  memberId  String
  member    RoomMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  playerId  String
  price     Int
  createdAt DateTime   @default(now())

  @@unique([roomId, playerId])
  @@index([createdAt])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String
  type      String // text | gif | log | sold_card
  text      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

// Each manager's fantasy XI for a finished auction, picked from the players they bought
model FantasySquad {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName     String
  teamId       String
  players      String[]
  captain      String
  viceCaptain  String
  impactPlayer String?
  updatedAt    DateTime @updatedAt

  @@unique([roomId, userId])
}

// A player's fantasy points across real matches, shared by every room
model PlayerStat {
  playerId    String   @id
  totalPoints Float    @default(0)
  matches     Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// One player's fantasy points in one real match, with the breakdown
model PlayerMatchPoint {
  id         String   @id @default(cuid())
  playerId   String
  playerName String
  matchId    String
  matchName  String
  points     Float
  details    Json
  updatedAt  DateTime @updatedAt

  @@unique([playerId, matchId])
}

// Matches already scored, so a re-run never counts one twice
model ProcessedMatch {
  matchId     String   @id
  name        String
  processedAt DateTime @default(now())
}

// Small key/value settings, e.g. where the daily fantasy update got to
model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
